# ============================================================================
# SurgicalFS MCP Server Configuration
# ============================================================================
# Place this file next to surgicalfs-mcp.exe, or at:
#   %APPDATA%\surgicalfs-mcp\config.toml
#
# Or specify via CLI: surgicalfs-mcp.exe --config "C:\path\to\surgicalfs.toml"
# ============================================================================

[server]
# ============================================================================
# HTTP TRANSPORT & AUTHENTICATION
# These settings apply only when running in HTTP mode (--transport http).
# For local stdio clients (Claude Desktop, Cursor), this section is ignored.
# ============================================================================

# Transport mode: "stdio" (default) or "http".
# - stdio: standard input/output, used by Claude Desktop and IDE integrations.
# - http: Streamable HTTP on the bind address below. Used for remote access
#   via Cloudflare Tunnel (or any reverse proxy).
# Can also be set via CLI: surgicalfs-mcp --transport http
# transport = "stdio"

# HTTP bind address (default: 127.0.0.1:8787).
# WARNING: Binding to 0.0.0.0 exposes the server on ALL network interfaces.
# For remote access, keep this as 127.0.0.1 and route through a tunnel.
# Can also be set via CLI: surgicalfs-mcp --bind 127.0.0.1:8787
# bind = "127.0.0.1:8787"

# Control-plane bind address (default: 127.0.0.1:9787).
# Serves the monitoring dashboard, metrics, and admin API.
# MUST remain localhost-only — never expose to the public internet.
# control_bind = "127.0.0.1:9787"


# Bearer token for the /mcp endpoint. When set, requests must include:
#   Authorization: Bearer <your-token-here>
# When empty (default), /mcp accepts unauthenticated requests.
#
# COMPATIBILITY NOTE: Claude.ai's web connector (custom integrations) does
# NOT support custom Authorization headers — it only supports OAuth 2.1.
# Setting auth_token will lock out the web connector with no way to send
# the token. For Claude.ai web access, leave this empty and rely on
# the Cloudflare WAF IP-allowlist (or Cloudflare Access) as the auth layer.
#
# auth_token IS effective for: Claude Desktop (JSON config `headers`),
# Claude Code (MCP config), API consumers (`authorization_token` field),
# and any client that supports custom HTTP headers.
#
# Generate a cryptographically strong token (256-bit / 32-byte CSPRNG):
#   PowerShell:  [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
#   Linux/macOS: openssl rand -base64 32
#
# auth_token = ""

# Per-request timeout in seconds (default: 120).
# Aborts hung tool calls with a JSON-RPC error instead of blocking forever.
# request_timeout_secs = 120

# Maximum concurrent in-flight requests (default: 10).
# Requests beyond this cap receive HTTP 503 with Retry-After.
# max_concurrent_requests = 10

[security]
# REQUIRED: At least one directory must be allowlisted.
# The server will ONLY access files within these directories.
# Use double backslashes for Windows paths.
allowed_directories = [
    "C:\\Users\\James\\Projects",
    "C:\\Users\\James\\Documents\\Notes",
]

# Whether to follow symbolic links (default: false)
# Setting this to false blocks symlink-based directory traversal attacks.
follow_symlinks = false

# Maximum file size in bytes for read operations (default: 5MB)
# Files exceeding this will return an error with a suggestion to use
# partial-read tools like file_read_lines or json_query.
max_file_size = 5_242_880

# Read-only mode: disable all write/mutation tools (default: false)
# Can also be set via CLI: surgicalfs-mcp --read-only
# read_only = false

[search]
# Path to ripgrep (rg) binary.
# "auto" = check PATH, then check next to this exe, then fall back to
#           PowerShell Select-String
# Or specify an absolute path: "C:\\tools\\rg.exe"
ripgrep_path = "auto"

# Maximum search results returned per file_search call
max_results = 100

# Lines of context shown around each search match
default_context_lines = 2

# Respect .gitignore files during search and directory listing (default: true)
# When true, search results and directory listings skip gitignored paths.
# Individual tool calls can override this with show_ignored=true.
respect_gitignore = true

[defaults]
# Default line count for file_head operations
head_lines = 50

# Default line count for file_tail operations
tail_lines = 50

# Maximum lines allowed in a single file_read_lines call
# Prevents accidentally loading huge ranges into context
max_read_lines = 500

# Text encoding: "utf-8", "utf-8-bom", "latin-1", or "auto"
# "auto" = try UTF-8, detect BOM, fall back to Windows-1252
encoding = "auto"

[response_budget]
# ============================================================================
# CONTEXT WINDOW PROTECTION
# These settings cap the size of ANY tool response before it enters
# Claude Desktop's context window. This is a hard server-side limit.
# ============================================================================

# Maximum lines in any single tool response (0 = unlimited)
max_response_lines = 200

# Maximum bytes in any single tool response (0 = unlimited)
max_response_bytes = 32_768

# How to truncate when over budget:
#   "smart" = cut at the nearest line break before the limit (clean output)
#   "hard"  = cut at exact byte offset (may split mid-line)
truncation_mode = "smart"

[tools]
# ============================================================================
# TOOL CATEGORY SELECTION
# Control which tool categories are registered. Reducing tool count lowers
# context window overhead from tool definitions (~250-500 tokens per tool).
# Default: all categories enabled (47 tools, ~14K tokens).
# ============================================================================
#
# Available categories:
#   inspect      - file_info, file_head, file_tail, file_read_lines (4 tools)
#   search       - file_search, file_grep, file_search_replace_preview (3 tools)
#   mutate       - file_replace, file_insert, file_append, file_patch_lines, file_batch_edit (5 tools)
#   json         - json_query, json_mutate (2 tools)
#   csv          - csv_info, csv_read, csv_query, csv_write (4 tools)
#   document     - pdf_info, pdf_extract, docx_extract (3 tools)
#   spreadsheet  - xlsx_info, xlsx_read, xlsx_query (3 tools)
#   manage       - file_write, file_write_chunked, file_write_stream, file_copy, file_delete, file_move (6 tools)
#   directory    - directory_list, directory_tree (2 tools)
#   utility      - file_checksum (1 tool)
#   compat       - 14 drop-in replacements for the default MCP filesystem server
#
# Examples:
#   All tools (default):
#     # enable = [...]   (omit the field entirely)
#
#   Core only (~17 tools, ~5K tokens, fits Cursor's 40-tool limit):
#     enable = ["inspect", "search", "mutate", "manage", "directory", "utility"]
#
#   Core + structured formats (~29 tools, ~9K tokens):
#     enable = ["inspect", "search", "mutate", "json", "csv", "document", "spreadsheet", "manage", "directory", "utility"]
#
# enable = ["inspect", "search", "mutate", "manage", "directory", "utility"]

[runtime]
# ============================================================================
# PROCESS LIFECYCLE
# ============================================================================
# Seconds of no tool activity after which the server self-exits (0 = never).
#
# Leave 0 for local stdio clients (Claude Desktop, Cursor, VS Code, etc.): the
# client closes stdin when it shuts down — that is the real exit signal — and an
# idle pause mid-session is normal, so a timer would kill a live server.
#
# Set a non-zero value ONLY for remote deployments behind `supergateway`, whose
# stateless streamableHttp mode spawns a fresh child per request and cannot
# reliably reap it on Windows. Without a self-imposed idle exit those children
# accumulate as orphans until the gateway exhausts its handles. See src/lifecycle.rs.
#   - Stateless supergateway (one child per request): 30 is plenty — each child
#     is single-shot, so it self-reaps ~30s after its one request.
#   - Stateful supergateway (one child per session): use a value LARGER than the
#     longest expected mid-conversation pause (e.g. 600), or a session's child
#     will be killed during think-time and the session will break.
#
# Can also be set via CLI (overrides this value): surgicalfs-mcp --idle-timeout-secs 30
# idle_timeout_secs = 0

[logging]
# ============================================================================
# STRUCTURED FILE LOGGING (HTTP mode)
# Rolling daily JSON log files. Independent of the analytics JSONL below.
# Can also be toggled from the dashboard, which writes a surgicalfs-logging.json
# override sidecar next to the config (delete it to revert to this TOML).
# ============================================================================

# Directory for daily log files (surgicalfs.log.YYYY-MM-DD). Empty (default) =
# stderr only — backward compatible with every prior release.
# log_dir = "C:\\Users\\James\\AppData\\Local\\Claude\\mcp\\logs"

# Days to retain log files (default: 0 = keep forever). Older files are deleted
# on startup and every 5 minutes. ACTIVE since v0.6.0 (was a placeholder before).
# retention_days = 30

[analytics]
# ============================================================================
# ANALYTICS (HTTP mode — operator-only)
# Tracks response bytes / estimated tokens per tool and per repo, with an
# append-only daily JSONL audit log and time-bucketed rollups surfaced on the
# control plane's /analytics endpoint and the dashboard's Analytics section.
#
# SECURITY: the JSONL log and /analytics contain FULL file paths (for repo
# aggregation). Both are operator-only — the JSONL file is a local artifact and
# /analytics is on the localhost-only, token-authenticated control plane. The
# redacted /events SSE stream is unaffected.
# ============================================================================

# Directory for daily JSONL analytics files. Empty (default) = analytics
# logging DISABLED — only in-memory session counters run, no files are written
# and the dashboard's day/week/month cards show "N/A". When set, daily files
# are written as surgicalfs-analytics-YYYY-MM-DD.jsonl.
# log_dir = "C:\\Users\\James\\AppData\\Local\\Claude\\mcp\\analytics"

# Days to retain analytics files (default: 90). 0 = keep forever. Older files
# are deleted on startup and every 5 minutes by the maintenance timer.
# retention_days = 90

# Characters-per-token estimate for the token display (default: 4.0).
# chars_per_token = 4.0

[dashboard]
# ============================================================================
# DASHBOARD DISPLAY (HTTP mode — informational only)
# Settings that affect what the control-plane dashboard shows. They do NOT
# change routing, auth, or any data-plane behavior.
# ============================================================================

# Public tunnel URL, shown in the dashboard's connection trace so an operator can
# see the end-to-end path (Claude.ai -> CF edge -> cloudflared -> local binds).
# Empty (default) = the trace shows only the local bind addresses.
# tunnel_url = "https://your-tunnel-host.example.com/mcp"
